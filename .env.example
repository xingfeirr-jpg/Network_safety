# Copy to .env and adjust.

# Absolute path on the Docker host for runtime data (source cache + live run output).
# It is mounted at the same path inside the UI container, so it MUST be absolute.
P17_RUNTIME_DIR=/srv/project17/runtime

# Host port of the web UI.
P17_PORT=8000

# Optional mirrors for slow networks (leave empty to use the defaults).
UBUNTU_MIRROR=
PIP_INDEX_URL=
# Example:
# UBUNTU_MIRROR=http://mirrors.ustc.edu.cn/ubuntu
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
